{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    { "source": "/api/appointments/book",  "destination": "/api/appointments/book.js" },
    { "source": "/api/appointments/list",  "destination": "/api/appointments/list.js" },
    { "source": "/api/contact/send",       "destination": "/api/contact/send.js" },
    { "source": "/api/analyze/mood",       "destination": "/api/analyze/mood.js" },
    { "source": "/api/auth/verify",        "destination": "/api/auth/verify.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",            "value": "DENY" },
        { "key": "Referrer-Policy",            "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}